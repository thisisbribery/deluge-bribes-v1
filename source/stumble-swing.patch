+    CYC_PADS(DrumEngine::CYC_KIK),
+    {DrumEngine::CYC_KIK, kPadMod1, FEEDBACK, &cycMacro1Menu},    // Color: drive
+    {DrumEngine::CYC_KIK, kPadOsc1, PULSE_WIDTH, &cycMacro2Menu}, // Shape: wave shape
