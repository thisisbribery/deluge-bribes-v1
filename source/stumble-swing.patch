diff --git a/tests/unit/cyc_tests.cpp b/tests/unit/cyc_tests.cpp
new file mode 100644
index 00000000..dcfd95e6
--- /dev/null
+++ b/tests/unit/cyc_tests.cpp
@@ -0,0 +1,198 @@
+#include "CppUTest/TestHarness.h"
+#include "dsp/drum_synth/cyc.h"
+#include "dsp/drum_synth/drum_synth.h"
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <vector>
+
+using namespace deluge::dsp::drum_synth;
+
+namespace {
+
+constexpr float kSampleRate = 44100.f;
+constexpr int32_t kNumKinds = static_cast<int32_t>(cyc::Kind::NUM_KINDS);
+
+uint32_t incrementForNote(double note) {
+	return static_cast<uint32_t>(440.0 * std::pow(2.0, (note - 69.0) / 12.0) / kSampleRate * 4294967296.0);
+}
+
+cyc::Settings middleSettings() {
+	cyc::Settings s;
+	s.macro = {0.4f, 0.4f, 0.4f, 0.4f};
+	s.decay = 0.4f;
+	return s;
+}
+
+std::vector<int32_t> renderNote(cyc::Kind kind, const cyc::Settings& s, double note, int32_t length, int32_t block) {
+	cyc::Voice voice;
+	voice.reset();
+	voice.trigger();
+	std::vector<int32_t> out(length);
+	for (int32_t i = 0; i < length; i += block) {
+		voice.render(kind, s, incrementForNote(note), kSampleRate, out.data() + i, std::min(block, length - i));
+	}
+	return out;
+}
+
+} // namespace
+
+TEST_GROUP(CycEngines){};
+
+TEST(CycEngines, sameEveryTime) {
+	for (int32_t k = 0; k < kNumKinds; k++) {
+		const auto kind = static_cast<cyc::Kind>(k);
+		CHECK(renderNote(kind, middleSettings(), 60, 22050, 128) == renderNote(kind, middleSettings(), 60, 22050, 128));
+	}
+}
+
+TEST(CycEngines, sameAtAnyHostBlockSize) {
+	for (int32_t k = 0; k < kNumKinds; k++) {
+		const auto kind = static_cast<cyc::Kind>(k);
+		const auto reference = renderNote(kind, middleSettings(), 60, 22050, 128);
+		for (int32_t block : {1, 7, 32, 100}) {
+			CHECK(renderNote(kind, middleSettings(), 60, 22050, block) == reference);
+		}
+	}
+}
+
+TEST(CycEngines, voicesDontShareState) {
+	for (int32_t k = 0; k < kNumKinds; k++) {
+		const auto kindA = static_cast<cyc::Kind>(k);
+		const auto kindB = static_cast<cyc::Kind>((k + 3) % kNumKinds);
+		cyc::Settings b = middleSettings();
+		b.macro = {0.9f, 0.1f, 0.7f, 0.2f};
+		cyc::Voice voiceA, voiceB;
+		voiceA.reset();
+		voiceB.reset();
+		voiceA.trigger();
+		voiceB.trigger();
+		constexpr int32_t kLength = 11025;
+		std::vector<int32_t> outA(kLength), outB(kLength);
+		for (int32_t i = 0; i < kLength; i += 128) {
+			const int32_t n = std::min(128, kLength - i);
+			voiceA.render(kindA, middleSettings(), incrementForNote(60), kSampleRate, outA.data() + i, n);
+			voiceB.render(kindB, b, incrementForNote(48), kSampleRate, outB.data() + i, n);
+		}
+		CHECK(outA == renderNote(kindA, middleSettings(), 60, kLength, 128));
+		CHECK(outB == renderNote(kindB, b, 48, kLength, 128));
+	}
+}
+
+TEST(CycEngines, soundAndStayInRangeAtTheExtremes) {
+	for (int32_t k = 0; k < kNumKinds; k++) {
+		const auto kind = static_cast<cyc::Kind>(k);
+		for (int32_t corner = 0; corner < 16; corner++) {
+			for (double note : {12.0, 60.0, 120.0}) {
+				cyc::Settings s;
+				for (int32_t m = 0; m < cyc::kNumMacros; m++) {
+					s.macro[m] = ((corner >> m) & 1) ? 1.f : 0.f;
+				}
+				s.decay = 1.f;
+				s.punch = (corner & 1) != 0;
+				const auto out = renderNote(kind, s, note, 4410, 128);
+				int64_t peak = 0;
+				for (int32_t x : out) {
+					CHECK(x != INT32_MIN);
+					peak = std::max<int64_t>(peak, std::llabs(x));
+				}
+				CHECK(peak > 0);
+			}
+		}
+	}
+}
+
+TEST(CycEngines, shortDecaysFreeTheVoice) {
+	for (int32_t k = 0; k < kNumKinds; k++) {
+		cyc::Voice voice;
+		voice.reset();
+		voice.trigger();
+		cyc::Settings s = middleSettings();
+		s.decay = 0.1f;
+		std::array<int32_t, 128> out{};
+		int32_t blocks = 0;
+		do {
+			voice.render(static_cast<cyc::Kind>(k), s, incrementForNote(60), kSampleRate, out.data(), 128);
+		} while (!voice.finished() && ++blocks < 44100 * 10 / 128);
+		CHECK(voice.finished());
+	}
+}
+
+TEST(CycEngines, defaultsAreLoudAndDriven) {
+	for (Engine engine : {Engine::CYC_KIK, Engine::CYC_SNR, Engine::CYC_TONE, Engine::CLAP_ENG}) {
+		const DrumControls c = DrumControls::defaultsFor(engine);
+		CHECK_EQUAL(100, c.value(DrumControls::CYC_DRIVE));
+		CHECK(c.value(DrumControls::COMMON_DECAY) >= 50);
+		const auto kind = cycKind(engine);
+		cyc::Settings s;
+		for (int32_t m = 0; m < cyc::kNumMacros; m++) {
+			s.macro[m] = c.value(m) / 127.f;
+		}
+		s.decay = c.value(DrumControls::COMMON_DECAY) / 127.f;
+		s.drive = c.value(DrumControls::CYC_DRIVE) / 127.f;
+		const auto out = renderNote(kind, s, 60, 11025, 128);
+		int64_t peak = 0;
+		for (int32_t x : out) {
+			peak = std::max<int64_t>(peak, std::llabs(x));
+		}
+		CHECK(peak > (INT32_MAX / 2)); // within 6 dB of full scale
+	}
+}
+
+TEST(CycEngines, everyEngineHasADriveAndDecay) {
+	for (uint8_t e = 0; e < static_cast<uint8_t>(Engine::NUM_ENGINES); e++) {
+		const auto engine = static_cast<Engine>(e);
+		CHECK(driveSlot(engine) != decaySlot(engine));
+		CHECK(driveSlot(engine) < DrumControls::NUM_SLOTS);
+		// The LXR voices' drive and decay start neutral, so older kits sound the same
+		if (isLxr(engine)) {
+			const DrumControls c = DrumControls::defaultsFor(Engine::TIA);
+			CHECK_EQUAL(0, c.value(driveSlot(engine)));
+			CHECK_EQUAL(127, c.value(decaySlot(engine)));
+		}
+	}
+}
+
+TEST(CycEngines, lxrDriveAndDecayWork) {
+	Patch patch;
+	patch.setPreset(Preset::KICK);
+	DrumControls controls = controlsFromPatch(patch);
+	auto peakAndFinish = [&](int32_t drive, int32_t decay, bool& finished) {
+		controls.values[DrumControls::LXR_DRIVE] = DrumControls::fromValue(drive);
+		controls.values[DrumControls::COMMON_DECAY] = DrumControls::fromValue(decay);
+		Voice voice;
+		voice.trigger(patch);
+		std::array<int32_t, 128> out{};
+		int64_t peak = 0;
+		for (int32_t b = 0; b < 44100 * 3 / 128; b++) {
+			out.fill(0);
+			voice.render(patch, controls, out.data(), 128, incrementForNote(48), 1 << 30, 0);
+			for (int32_t x : out) {
+				peak = std::max<int64_t>(peak, std::llabs(x));
+			}
+		}
+		finished = voice.finished();
+		return peak;
+	};
+	bool finished = false;
+	const int64_t plain = peakAndFinish(0, 127, finished);
+	CHECK(!finished);
+	const int64_t driven = peakAndFinish(127, 127, finished);
+	CHECK(driven > plain);
+	peakAndFinish(0, 20, finished);
+	CHECK(finished);
+}
+
+TEST(CycEngines, enginesAreNumberedAfterTheXiaOnes) {
+	// The engine number is saved with the sound: existing engines must keep theirs
+	CHECK_EQUAL(5, static_cast<int32_t>(Engine::CYC_KIK));
+	CHECK_EQUAL(12, static_cast<int32_t>(Engine::CLAP_ENG));
+	CHECK(isCyc(Engine::CLAP_ENG));
+	CHECK(!isCyc(Engine::IIA));
+	CHECK(isLxr(Engine::METAL));
+	CHECK(cycKind(Engine::VTG_SNR) == cyc::Kind::VSNR);
+	CHECK(Patch::isUsedBy(Patch::XIA_PUNCH, Engine::CYC_TONE));
+	CHECK(!Patch::isUsedBy(Patch::XIA_VARIANT, Engine::CYC_TONE));
+	CHECK(!Patch::isUsedBy(Patch::OSC_WAVE, Engine::CYC_KIK));
+}
diff --git a/tests/unit/drum_synth_tests.cpp b/tests/unit/drum_synth_tests.cpp
new file mode 100644
index 00000000..ab97eec9
--- /dev/null
+++ b/tests/unit/drum_synth_tests.cpp
@@ -0,0 +1,340 @@
+#include "CppUTest/TestHarness.h"
+#include "dsp/drum_synth/drum_synth.h"
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+
+using namespace deluge::dsp::drum_synth;
+
+namespace {
+
+constexpr int32_t kSampleRate = 44100;
+constexpr int32_t kAmplitude = 1 << 27;
+
+constexpr uint32_t phaseIncrementFor(double hz) {
+	return static_cast<uint32_t>(hz / kSampleRate * 4294967296.0);
+}
+
+/// Render in Deluge-sized chunks (the audio engine renders up to 128 samples at a time)
+/// controls: the Deluge params the engine's continuous settings live on. By default, the patch's own settings.
+template <size_t N>
+void renderInto(Voice& voice, const Patch& patch, std::array<int32_t, N>& out, double hz = 49.0,
+                const DrumControls* controls = nullptr) {
+	const DrumControls c = controls ? *controls : controlsFromPatch(patch);
+	out.fill(0);
+	for (size_t pos = 0; pos < N; pos += 128) {
+		int32_t n = static_cast<int32_t>(std::min<size_t>(128, N - pos));
+		voice.render(patch, c, out.data() + pos, n, phaseIncrementFor(hz), kAmplitude, 0);
+	}
+}
+
+int32_t countZeroCrossings(const int32_t* start, int32_t length) {
+	int32_t count = 0;
+	for (int32_t i = 1; i < length; i++) {
+		if ((start[i - 1] < 0) != (start[i] < 0)) {
+			count++;
+		}
+	}
+	return count;
+}
+
+int32_t peak(const int32_t* start, int32_t length) {
+	int32_t p = 0;
+	for (int32_t i = 0; i < length; i++) {
+		p = std::max(p, std::abs(start[i]));
+	}
+	return p;
+}
+
+/// Mean absolute difference between neighbouring samples, relative to level: a rough brightness measure
+double brightness(const int32_t* start, int32_t length) {
+	double diff = 0;
+	double level = 0;
+	for (int32_t i = 1; i < length; i++) {
+		diff += std::abs(static_cast<double>(start[i]) - start[i - 1]);
+		level += std::abs(static_cast<double>(start[i]));
+	}
+	return level > 0 ? diff / level : 0;
+}
+
+Patch presetPatch(Preset preset) {
+	Patch patch;
+	patch.setPreset(preset);
+	return patch;
+}
+
+} // namespace
+
+TEST_GROUP(DrumSynthTest){};
+
+TEST(DrumSynthTest, everyPresetMakesSound) {
+	for (uint8_t p = 0; p < static_cast<uint8_t>(Preset::NUM_PRESETS); p++) {
+		Patch patch = presetPatch(static_cast<Preset>(p));
+		Voice voice;
+		voice.trigger(patch);
+		std::array<int32_t, 4410> out{};
+		renderInto(voice, patch, out, 200.0);
+		CHECK(peak(out.data(), out.size()) > kAmplitude / 8);
+	}
+}
+
+TEST(DrumSynthTest, presetsPickTheirEngines) {
+	CHECK(presetPatch(Preset::KICK).engine() == Engine::DRUM);
+	CHECK(presetPatch(Preset::LOW_TOM).engine() == Engine::DRUM);
+	CHECK(presetPatch(Preset::SNARE).engine() == Engine::SNARE);
+	CHECK(presetPatch(Preset::CLOSED_HAT).engine() == Engine::METAL);
+	CHECK(presetPatch(Preset::CYMBAL).engine() == Engine::METAL);
+}
+
+TEST(DrumSynthTest, kickPitchFalls) {
+	Patch patch = presetPatch(Preset::KICK);
+	Voice voice;
+	voice.trigger(patch);
+
+	// 500 ms
+	std::array<int32_t, 22050> out{};
+	renderInto(voice, patch, out);
+
+	// 20 ms windows: the start of the hit sweeps from several times the base pitch down to it
+	constexpr int32_t window = 882;
+	int32_t early = countZeroCrossings(out.data(), window);
+	int32_t late = countZeroCrossings(out.data() + 22050 - window, window);
+	CHECK(early > late * 2);
+
+	// Once the pitch envelope has finished the kick sits at its base pitch: 49 Hz is ~2 crossings per 20 ms
+	CHECK(late >= 1);
+	CHECK(late <= 3);
+}
+
+TEST(DrumSynthTest, snareNoiseFilterShapesTheNoise) {
+	// Noise only, so the filter is all that differs
+	Patch patch = presetPatch(Preset::SNARE);
+	patch.set(Patch::NOISE_MIX, 127);
+	patch.set(Patch::TRANS_VOLUME, 0);
+	patch.set(Patch::NOISE_RESONANCE, 0);
+	patch.set(Patch::NOISE_CUTOFF, 64);
+
+	patch.set(Patch::NOISE_FILTER_TYPE, static_cast<uint8_t>(NoiseFilter::LOW_PASS));
+	Voice low;
+	low.trigger(patch);
+	std::array<int32_t, 8192> lowOut{};
+	renderInto(low, patch, lowOut, 185.0);
+
+	patch.set(Patch::NOISE_FILTER_TYPE, static_cast<uint8_t>(NoiseFilter::HIGH_PASS));
+	Voice high;
+	high.trigger(patch);
+	std::array<int32_t, 8192> highOut{};
+	renderInto(high, patch, highOut, 185.0);
+
+	CHECK(peak(lowOut.data(), lowOut.size()) > 0);
+	CHECK(peak(highOut.data(), highOut.size()) > 0);
+	CHECK(brightness(highOut.data(), highOut.size()) > brightness(lowOut.data(), lowOut.size()) * 2);
+}
+
+TEST(DrumSynthTest, metalFmMakesItBrighter) {
+	Patch patch = presetPatch(Preset::CYMBAL);
+	patch.set(Patch::OSC_WAVE, static_cast<uint8_t>(Wave::SINE));
+	patch.set(Patch::TRANS_VOLUME, 0);
+
+	patch.set(Patch::FM_AMOUNT, 0);
+	patch.set(Patch::FM2_AMOUNT, 0);
+	Voice plain;
+	plain.trigger(patch);
+	std::array<int32_t, 4096> plainOut{};
+	renderInto(plain, patch, plainOut, 400.0);
+
+	patch.set(Patch::FM_AMOUNT, 127);
+	patch.set(Patch::FM2_AMOUNT, 127);
+	Voice fm;
+	fm.trigger(patch);
+	std::array<int32_t, 4096> fmOut{};
+	renderInto(fm, patch, fmOut, 400.0);
+
+	CHECK(brightness(fmOut.data(), fmOut.size()) > brightness(plainOut.data(), plainOut.size()) * 2);
+}
+
+TEST(DrumSynthTest, controlsCarryEveryLxrSetting) {
+	// Each engine's continuous settings go onto the controls and come back unchanged
+	for (Preset preset : {Preset::KICK, Preset::SNARE, Preset::CYMBAL}) {
+		Patch patch = presetPatch(preset);
+		patch.set(Patch::PITCH_DECAY, 17);
+		patch.set(Patch::NOISE_RESONANCE, 99);
+		patch.set(Patch::FM2_AMOUNT, 3);
+		Patch copy = presetPatch(preset);
+		storeControlsInPatch(controlsFromPatch(patch), copy);
+		for (uint8_t p = 0; p < Patch::NUM_PARAMS; p++) {
+			const auto param = static_cast<Patch::Param>(p);
+			if (Patch::isUsedBy(param, patch.engine())) {
+				LONGS_EQUAL(patch.get(param), copy.get(param));
+			}
+		}
+	}
+}
+
+TEST(DrumSynthTest, eachEngineUsesDistinctControls) {
+	for (Engine engine : {Engine::DRUM, Engine::SNARE, Engine::METAL}) {
+		std::array<bool, DrumControls::NUM_SLOTS> taken{};
+		for (uint8_t p = 0; p < Patch::NUM_PARAMS; p++) {
+			const auto param = static_cast<Patch::Param>(p);
+			const int32_t slot = lxrControlSlot(param);
+			if (slot < 0 || !Patch::isUsedBy(param, engine)) {
+				continue;
+			}
+			CHECK_FALSE(taken[slot]);
+			taken[slot] = true;
+		}
+	}
+}
+
+TEST(DrumSynthTest, pitchAmountKnobDeepensTheSweep) {
+	Patch patch = presetPatch(Preset::KICK);
+	patch.set(Patch::TRANS_VOLUME, 0);
+	constexpr int32_t window = 441; // the first 10 ms
+
+	Voice centred;
+	centred.trigger(patch);
+	std::array<int32_t, 441> centredOut{};
+	renderInto(centred, patch, centredOut);
+
+	DrumControls up = controlsFromPatch(patch);
+	up.values[lxrControlSlot(Patch::PITCH_AMOUNT)] = INT32_MAX; // knob fully clockwise
+	Voice turned;
+	turned.trigger(patch);
+	std::array<int32_t, 441> turnedOut{};
+	renderInto(turned, patch, turnedOut, 49.0, &up);
+
+	CHECK(countZeroCrossings(turnedOut.data(), window) > countZeroCrossings(centredOut.data(), window));
+}
+
+TEST(DrumSynthTest, retriggerIsRepeatable) {
+	Patch patch = presetPatch(Preset::LOW_TOM);
+
+	Voice a;
+	a.trigger(patch);
+	std::array<int32_t, 2048> first{};
+	renderInto(a, patch, first);
+
+	a.trigger(patch);
+	std::array<int32_t, 2048> second{};
+	renderInto(a, patch, second);
+
+	for (size_t i = 0; i < first.size(); i++) {
+		LONGS_EQUAL(first[i], second[i]);
+	}
+}
+
+TEST(DrumSynthTest, chunkSizeDoesNotChangeOutput) {
+	for (Preset preset : {Preset::HIGH_TOM, Preset::SNARE, Preset::OPEN_HAT}) {
+		Patch patch = presetPatch(preset);
+
+		Voice whole;
+		whole.trigger(patch);
+		std::array<int32_t, 1024> a{};
+		renderInto(whole, patch, a, 300.0);
+
+		// Odd chunk sizes cross the 16-sample control ticks at different points
+		Voice pieces;
+		pieces.trigger(patch);
+		std::array<int32_t, 1024> b{};
+		size_t pos = 0;
+		int32_t sizes[] = {4, 36, 100, 12, 128, 60};
+		for (int32_t i = 0; pos < b.size(); i++) {
+			int32_t n = std::min<int32_t>(sizes[i % 6], b.size() - pos);
+			pieces.render(patch, controlsFromPatch(patch), b.data() + pos, n, phaseIncrementFor(300.0), kAmplitude, 0);
+			pos += n;
+		}
+
+		for (size_t i = 0; i < a.size(); i++) {
+			LONGS_EQUAL(a[i], b[i]);
+		}
+	}
+}
+
+TEST(DrumSynthTest, everyEngineWaveAndTransientRenders) {
+	for (uint8_t engine = 0; engine < static_cast<uint8_t>(Engine::NUM_ENGINES); engine++) {
+		for (uint8_t mode = 0; mode < kNumTransientModes; mode++) {
+			for (uint8_t w = 0; w < static_cast<uint8_t>(Wave::NUM_WAVES); w++) {
+				Patch patch;
+				patch.set(Patch::ENGINE, engine);
+				patch.set(Patch::TRANS_MODE, mode);
+				patch.set(Patch::TRANS_VOLUME, 127);
+				patch.set(Patch::OSC_WAVE, w);
+				patch.set(Patch::MOD_WAVE, w);
+				patch.set(Patch::MOD2_WAVE, w);
+				patch.set(Patch::FM_AMOUNT, 127);
+				patch.set(Patch::FM2_AMOUNT, 127);
+				patch.set(Patch::PITCH_AMOUNT, 127);
+				patch.set(Patch::NOISE_MIX, 64);
+				patch.set(Patch::NOISE_RESONANCE, 127);
+				Voice voice;
+				voice.trigger(patch);
+				std::array<int32_t, 2205> out{};
+				renderInto(voice, patch, out, 300.0);
+				CHECK(peak(out.data(), out.size()) > 0);
+			}
+		}
+	}
+}
+
+TEST(DrumSynthTest, extremeSettingsStayInRange) {
+	// Slope 0 is 0 / 0 in the LXR curve, slope 127 divides by zero, and full resonance can ring hard
+	for (uint8_t engine = 0; engine < static_cast<uint8_t>(Engine::NUM_ENGINES); engine++) {
+		for (uint8_t extreme : {uint8_t{0}, uint8_t{127}}) {
+			Patch patch;
+			patch.set(Patch::ENGINE, engine);
+			patch.set(Patch::PITCH_SLOPE, extreme);
+			patch.set(Patch::PITCH_DECAY, extreme);
+			patch.set(Patch::NOISE_CUTOFF, extreme);
+			patch.set(Patch::NOISE_RESONANCE, 127);
+			patch.set(Patch::NOISE_MIX, 127);
+			DrumControls controls = controlsFromPatch(patch);
+			controls.values.fill(extreme ? INT32_MAX : INT32_MIN);
+			Voice voice;
+			voice.trigger(patch);
+			std::array<int32_t, 4096> out{};
+			renderInto(voice, patch, out, 49.0, &controls);
+			CHECK(peak(out.data(), out.size()) <= (kAmplitude << 1));
+		}
+	}
+}
+
+TEST(DrumSynthTest, loadingClampsBadBytes) {
+	Patch patch;
+	patch.bytes().fill(255);
+	patch.clampAll();
+	LONGS_EQUAL(static_cast<int>(Engine::NUM_ENGINES) - 1, patch.get(Patch::ENGINE));
+	LONGS_EQUAL(static_cast<int>(Wave::NUM_WAVES) - 1, patch.get(Patch::OSC_WAVE));
+	LONGS_EQUAL(1, patch.get(Patch::MIX_MODE));
+	LONGS_EQUAL(static_cast<int>(NoiseFilter::NUM_FILTERS) - 1, patch.get(Patch::NOISE_FILTER_TYPE));
+	LONGS_EQUAL(kNumTransientModes - 1, patch.get(Patch::TRANS_MODE));
+	LONGS_EQUAL(127, patch.get(Patch::FM_AMOUNT));
+}
+
+TEST(DrumSynthTest, legacyKitsLoadAsDrums) {
+	// The first test build saved 12 bytes in this order: osc wave, mod wave, mod coarse, mod fine, FM, mix mode,
+	// pitch decay, pitch slope, pitch amount, transient mode, transient volume, transient pitch
+	const uint8_t legacy[12] = {1, 2, 70, 60, 33, 1, 44, 55, 66, 5, 77, 88};
+	Patch patch;
+	patch.setPreset(Preset::CYMBAL);
+	patch.readLegacyDrumBytes(legacy, 12);
+	CHECK(patch.engine() == Engine::DRUM);
+	LONGS_EQUAL(1, patch.get(Patch::OSC_WAVE));
+	LONGS_EQUAL(2, patch.get(Patch::MOD_WAVE));
+	LONGS_EQUAL(70, patch.get(Patch::MOD_COARSE));
+	LONGS_EQUAL(33, patch.get(Patch::FM_AMOUNT));
+	LONGS_EQUAL(1, patch.get(Patch::MIX_MODE));
+	LONGS_EQUAL(66, patch.get(Patch::PITCH_AMOUNT));
+	LONGS_EQUAL(5, patch.get(Patch::TRANS_MODE));
+	LONGS_EQUAL(88, patch.get(Patch::TRANS_PITCH));
+}
+
+TEST(DrumSynthTest, enginesOnlyShowTheirSettings) {
+	CHECK(Patch::isUsedBy(Patch::PITCH_AMOUNT, Engine::DRUM));
+	CHECK_FALSE(Patch::isUsedBy(Patch::PITCH_AMOUNT, Engine::METAL));
+	CHECK(Patch::isUsedBy(Patch::NOISE_CUTOFF, Engine::SNARE));
+	CHECK_FALSE(Patch::isUsedBy(Patch::NOISE_CUTOFF, Engine::DRUM));
+	CHECK(Patch::isUsedBy(Patch::FM2_AMOUNT, Engine::METAL));
+	CHECK_FALSE(Patch::isUsedBy(Patch::MOD_WAVE, Engine::SNARE));
+	CHECK(Patch::isUsedBy(Patch::TRANS_MODE, Engine::METAL));
+}
diff --git a/tests/unit/swing_style_tests.cpp b/tests/unit/swing_style_tests.cpp
new file mode 100644
index 00000000..1c5c20bf
--- /dev/null
+++ b/tests/unit/swing_style_tests.cpp
@@ -0,0 +1,69 @@
+#include "CppUTest/TestHarness.h"
+#include "model/swing/swing_style.h"
+
+using namespace deluge::swing_style;
+
+namespace {
+constexpr uint32_t kSixteenth = 24; // Swing interval in internal ticks at the default 96 ticks per quarter note
+
+double unswungTick(Style style, int32_t level, uint32_t swungTick) {
+	return swungToUnswung(style, level, kSixteenth, swungTick) / 65536.0;
+}
+} // namespace
+
+TEST_GROUP(SwingStyleTests){};
+
+TEST(SwingStyleTests, namesRoundTrip) {
+	for (int32_t i = 0; i < kNumStyles; i++) {
+		auto style = static_cast<Style>(i);
+		CHECK(fromName(getName(style)) == style);
+	}
+	CHECK(fromName("NOT A STYLE") == Style::CLASSIC);
+}
+
+TEST(SwingStyleTests, stepsLandWhereTheVisualiserPutsThem) {
+	// HOPP level 1: the even 16th lands on tick 26 of the pair
+	DOUBLES_EQUAL(26.0, unswungTick(Style::HOPP, 1, 24), 0.001);
+	// DEEP level 6: the 8ths split 66.7%, so the "&" drags to tick 64.032 of the beat
+	DOUBLES_EQUAL(64.032, unswungTick(Style::DEEP, 6, 48), 0.001);
+	// FOLD level 6: the e and a fold 14.4 ticks in toward the &, which stays put
+	DOUBLES_EQUAL(38.4, unswungTick(Style::FOLD, 6, 24), 0.001);
+	DOUBLES_EQUAL(48.0, unswungTick(Style::FOLD, 6, 48), 0.001);
+	DOUBLES_EQUAL(57.6, unswungTick(Style::FOLD, 6, 72), 0.001);
+	// SQEZ level 6: 36 ticks per beat on the module, the a on tick 34, so 34 * 96 / 36 at the Deluge's 96
+	DOUBLES_EQUAL(90.667, unswungTick(Style::SQEZ, 6, 72), 0.001);
+}
+
+TEST(SwingStyleTests, blocksStartAndEndOnTheGrid) {
+	for (int32_t i = 1; i < kNumStyles; i++) {
+		auto style = static_cast<Style>(i);
+		uint32_t block = getNumSteps(style) * kSixteenth;
+		for (int32_t level = 1; level <= kMaxLevel; level++) {
+			DOUBLES_EQUAL(0.0, unswungTick(style, level, 0), 0.0);
+			DOUBLES_EQUAL((double)block, unswungTick(style, level, block), 0.0);
+		}
+	}
+}
+
+TEST(SwingStyleTests, unswungToSwungInvertsSwungToUnswung) {
+	for (int32_t i = 1; i < kNumStyles; i++) {
+		auto style = static_cast<Style>(i);
+		for (uint32_t interval : {kSixteenth, 2 * kSixteenth}) {
+			uint32_t block = getNumSteps(style) * interval;
+			for (int32_t level = 1; level <= kMaxLevel; level++) {
+				uint64_t previous = 0;
+				for (uint32_t tick = 0; tick < block; tick++) {
+					uint64_t unswung = swungToUnswung(style, level, interval, tick);
+					if (tick > 0) {
+						CHECK(unswung > previous);
+					}
+					previous = unswung;
+					CHECK_EQUAL(tick, unswungToSwung(style, level, interval, unswung));
+					// Just before the next tick is still this tick
+					uint64_t nextUnswung = swungToUnswung(style, level, interval, tick + 1);
+					CHECK_EQUAL(tick, unswungToSwung(style, level, interval, nextUnswung - 1));
+				}
+			}
+		}
+	}
+}
diff --git a/tests/unit/xia_tests.cpp b/tests/unit/xia_tests.cpp
new file mode 100644
index 00000000..d801dfee
--- /dev/null
+++ b/tests/unit/xia_tests.cpp
@@ -0,0 +1,328 @@
+#include "CppUTest/TestHarness.h"
+#include "dsp/drum_synth/drum_synth.h"
+#include "dsp/drum_synth/xia.h"
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+using namespace deluge::dsp::drum_synth;
+
+namespace {
+
+// Hashes of every output sample and every state word, block by block, for scenarios rendered by the XIA engines'
+// original code in the Model:Cycles firmware, run in an emulator. The scenario generator below must stay identical
+// to the one that made them (golden_hash.py, with the emulator, kept outside this repository with the firmware).
+constexpr std::array<uint64_t, 24> kTiaHashes{
+    0x2efa41b4d010c362ull, 0xaac43efc0601c9e7ull, 0xd848c1b0eac48507ull, 0xc577a8f7ed71c373ull, 0x064ae3491ea23762ull,
+    0xcdf659e260ddb8a0ull, 0x8cf66777621e120aull, 0x5fc39b0409106bc7ull, 0x8f68f1570522272aull, 0x3b5813b238d88f07ull,
+    0xc1148369aafee069ull, 0x440f857f14d7a9f8ull, 0xa63ead43ca2ff06full, 0xdf40296203fc8262ull, 0x12e3c68d9341c82full,
+    0x2264d7ecf42ac9d0ull, 0xec66f5862b7b5975ull, 0xe2184242b5981b88ull, 0x29be585fa07d9340ull, 0x151289c080587590ull,
+    0x6b6c3a9099fa6e0aull, 0xdee25304c9bd3a0eull, 0x2bd0c1cc80e896e6ull, 0x2d95f31a5a9418d4ull,
+};
+constexpr std::array<uint64_t, 24> kIiaHashes{
+    0xc9c7c68e4a2c3130ull, 0x46988d8958d32a8full, 0x0d6ebe1a96b34d47ull, 0x95abb440da79308aull, 0x4d3a5da8effc1408ull,
+    0x025ae5d3bc811547ull, 0x11295a5f21b063d2ull, 0xe5f1e2349a8767a9ull, 0xbaa862eed0c6b0baull, 0x01d046e8752d2631ull,
+    0x337f54b541a1fef6ull, 0xf53238a1e544cb4eull, 0xe1a112ed060d976cull, 0xdc34da8d96b0fda7ull, 0x4a706381e0de7992ull,
+    0xcaa6dd5b005c153eull, 0xc0706335981146faull, 0x84f45f813c66b4acull, 0x081bad005f88909dull, 0x8788a14b3a72210cull,
+    0x41c70529644fe5beull, 0x603252a04724c41eull, 0xfad17f471f47036aull, 0xf720e06245e3bb36ull,
+};
+
+constexpr int32_t kBlocks = 200;
+
+class Rng {
+public:
+	explicit Rng(uint32_t seed) : x_(seed) {}
+	uint32_t next() {
+		x_ ^= x_ << 13;
+		x_ ^= x_ >> 17;
+		x_ ^= x_ << 5;
+		return x_;
+	}
+	int32_t range(int32_t lo, int32_t hi) {
+		return lo + static_cast<int32_t>(next() % static_cast<uint32_t>(hi - lo + 1));
+	}
+	int32_t knob() {
+		switch (next() % 4) {
+		case 0:
+			return range(0, 0x7F00);
+		case 1:
+			return static_cast<int32_t>(next() % 128) * 256;
+		case 2:
+			return 0x4000;
+		default:
+			return 0x7F00;
+		}
+	}
+
+private:
+	uint32_t x_;
+};
+
+struct Common {
+	int32_t lowPass, drive, decay;
+};
+
+Common common(Rng& r) {
+	Common c{};
+	c.lowPass = (r.next() % 3 == 0) ? 0x7F00 : r.range(0x1800, 0x7F00);
+	c.drive = (r.next() % 2) ? 0 : r.knob();
+	c.decay = (r.next() % 3 == 0) ? 0x7F00 : r.range(0x4800, 0x7EFF);
+	return c;
+}
+
+xia::TiaSettings tiaScenario(Rng& r, int32_t variant) {
+	xia::TiaSettings t{};
+	t.variant = variant;
+	for (int32_t& f : t.freq) {
+		f = r.knob();
+	}
+	for (int32_t& b : t.blendex) {
+		b = (r.next() % 3 == 0) ? 0 : r.range(0, 0x7FFF);
+	}
+	const Common c = common(r);
+	t.lowPass = c.lowPass;
+	t.drive = c.drive;
+	t.decay = c.decay;
+	t.pitch = r.range(0x180000, 0x6C0000);
+	t.punch = (r.next() % 4 == 0) ? 1 : 0;
+	t.gate = (r.next() % 6 == 0) ? 1 : 0;
+	return t;
+}
+
+xia::IiaSettings iiaScenario(Rng& r, int32_t variant) {
+	xia::IiaSettings t{};
+	t.variant = variant;
+	t.weight = r.knob();
+	t.alloy = r.knob();
+	const Common c = common(r);
+	t.lowPass = c.lowPass;
+	t.drive = c.drive;
+	t.decay = c.decay;
+	t.shape = r.knob();
+	t.attack = (r.next() % 2) ? r.range(0, 0x7F00) : 0x4000;
+	t.pitch = r.range(0x180000, 0x6C0000);
+	t.punch = (r.next() % 4 == 0) ? 1 : 0;
+	t.gate = (r.next() % 6 == 0) ? 1 : 0;
+	return t;
+}
+
+uint64_t fnv(uint64_t h, const void* data, size_t size) {
+	const auto* bytes = static_cast<const uint8_t*>(data);
+	for (size_t i = 0; i < size; i++) {
+		h ^= bytes[i];
+		h *= 0x100000001B3ull;
+	}
+	return h;
+}
+
+template <class State, class Settings, class Make>
+uint64_t scenarioHash(int32_t scenario, uint32_t engineSalt, Make make) {
+	Rng r(0x9E3779B9u ^ (static_cast<uint32_t>(scenario) * 0x85EBCA6Bu) ^ engineSalt);
+	const int32_t variant = scenario % 3;
+	Settings settings = make(r, variant);
+	State state;
+	xia::reset(state);
+	uint64_t h = 0xCBF29CE484222325ull;
+	for (int32_t b = 0; b < kBlocks; b++) {
+		if (scenario % 2 == 1 && b > 0 && b % 25 == 0) {
+			const int32_t pitch = settings.pitch;
+			settings = make(r, variant);
+			settings.pitch = pitch;
+		}
+		const bool trigger = b == 0 || (scenario % 4 == 2 && b == 120);
+		const bool fadeOut = scenario % 4 == 2 && b == 119;
+		Settings block = settings;
+		if (block.gate && b >= 80) {
+			block.release = 1;
+		}
+		int32_t out[xia::kBlockSize];
+		xia::render(state, block, trigger, fadeOut, out);
+		h = fnv(h, out, sizeof(out)); // Little-endian, as the generator writes them
+		h = fnv(h, &state, sizeof(state));
+	}
+	return h;
+}
+
+constexpr int32_t kSampleRate = 44100;
+
+uint32_t phaseIncrementFor(double hz) {
+	return static_cast<uint32_t>(hz / kSampleRate * 4294967296.0);
+}
+
+/// Render a triggered voice, returning how many samples it ran before finishing (or the whole length)
+int32_t renderVoice(Voice& voice, const Patch& patch, int32_t* out, int32_t length, double hz,
+                    const DrumControls& controls) {
+	voice.trigger(patch);
+	std::fill(out, out + length, 0);
+	for (int32_t pos = 0; pos < length; pos += 100) { // Deluge-style chunks that don't line up with XIA blocks
+		const int32_t n = std::min(100, length - pos);
+		voice.render(patch, controls, out + pos, n, phaseIncrementFor(hz), 1 << 27, 0);
+		if (voice.finished()) {
+			return pos + n;
+		}
+	}
+	return length;
+}
+
+double zeroCrossingHz(const int32_t* out, int32_t start, int32_t length) {
+	int32_t crossings = 0;
+	for (int32_t i = start + 1; i < start + length; i++) {
+		if ((out[i - 1] < 0) && (out[i] >= 0)) {
+			crossings++;
+		}
+	}
+	return crossings * static_cast<double>(kSampleRate) / length;
+}
+
+} // namespace
+
+TEST_GROUP(XiaTests){};
+
+TEST(XiaTests, tiaMatchesTheOriginalSampleForSample) {
+	for (int32_t s = 0; s < 24; s++) {
+		const uint64_t h = scenarioHash<xia::TiaState, xia::TiaSettings>(s, 0, tiaScenario);
+		if (h != kTiaHashes[s]) {
+			FAIL(("TIA scenario " + std::to_string(s) + " differs from the original").c_str());
+		}
+	}
+}
+
+TEST(XiaTests, iiaMatchesTheOriginalSampleForSample) {
+	for (int32_t s = 0; s < 24; s++) {
+		const uint64_t h = scenarioHash<xia::IiaState, xia::IiaSettings>(s, 1, iiaScenario);
+		if (h != kIiaHashes[s]) {
+			FAIL(("IIA scenario " + std::to_string(s) + " differs from the original").c_str());
+		}
+	}
+}
+
+TEST(XiaTests, controlValuesMapLikeTheCyclesKnobs) {
+	CHECK_EQUAL(0, DrumControls::toKnob(INT32_MIN));
+	CHECK_EQUAL(0x4000, DrumControls::toKnob(0));
+	CHECK_EQUAL(0x7F00, DrumControls::toKnob(INT32_MAX));
+	for (int32_t v = 0; v <= 127; v++) {
+		CHECK_EQUAL(v << 8, DrumControls::toKnob(DrumControls::fromValue(v)));
+	}
+}
+
+TEST(XiaTests, tiaPlaysTheDelugesPitch) {
+	// TIA's defaults are a plain sine, so its pitch is easy to count
+	Patch patch;
+	patch.setXiaPreset(Engine::TIA, 0);
+	const DrumControls controls = DrumControls::defaultsFor(Engine::TIA);
+	static std::array<int32_t, kSampleRate> out;
+	Voice voice;
+	for (double hz : {55.0, 261.63, 1000.0}) {
+		renderVoice(voice, patch, out.data(), kSampleRate, hz, controls);
+		DOUBLES_EQUAL(hz, zeroCrossingHz(out.data(), 0, kSampleRate), hz * 0.01 + 1);
+	}
+}
+
+TEST(XiaTests, theDelugeEnvelopeShapesTheSoundByDefault) {
+	// With their defaults the engines hold their level, and the voice lasts as long as the Deluge's envelope says
+	static std::array<int32_t, kSampleRate * 2> out;
+	for (Engine engine : {Engine::TIA, Engine::IIA}) {
+		Patch patch;
+		patch.setXiaPreset(engine, 0);
+		Voice voice;
+		const int32_t length =
+		    renderVoice(voice, patch, out.data(), out.size(), 130.8, DrumControls::defaultsFor(engine));
+		CHECK_EQUAL(static_cast<int32_t>(out.size()), length);
+		CHECK_FALSE(voice.finished());
+		int32_t lateLevel = 0;
+		for (size_t i = out.size() - 4410; i < out.size(); i++) {
+			lateLevel = std::max(lateLevel, std::abs(out[i]));
+		}
+		CHECK(lateLevel > (1 << 20));
+	}
+}
+
+TEST(XiaTests, engineDecayEndsTheVoice) {
+	static std::array<int32_t, kSampleRate * 4> out;
+	for (Engine engine : {Engine::TIA, Engine::IIA}) {
+		for (uint8_t variant = 0; variant < 3; variant++) {
+			Patch patch;
+			patch.setXiaPreset(engine, variant);
+			DrumControls controls = DrumControls::defaultsFor(engine);
+			controls.values[DrumControls::ENGINE_DECAY] = DrumControls::fromValue(60);
+			Voice voice;
+			const int32_t length = renderVoice(voice, patch, out.data(), out.size(), 130.8, controls);
+			CHECK(voice.finished());
+			CHECK(length < static_cast<int32_t>(out.size()));
+			int32_t peak = 0;
+			for (int32_t i = 0; i < length; i++) {
+				peak = std::max(peak, std::abs(out[i]));
+			}
+			CHECK(peak > (1 << 20));
+		}
+	}
+}
+
+TEST(XiaTests, lxrEnginesNeverReportFinished) {
+	Patch patch;
+	patch.setPreset(Preset::KICK);
+	static std::array<int32_t, kSampleRate> out;
+	Voice voice;
+	renderVoice(voice, patch, out.data(), out.size(), 49.0, controlsFromPatch(patch));
+	CHECK_FALSE(voice.finished());
+}
+
+TEST(XiaTests, controlsChangeTheSound) {
+	// Blendex 1 turns TIA's first operator from heard into modulating: the sine gets harmonics
+	Patch patch;
+	patch.setXiaPreset(Engine::TIA, 0);
+	DrumControls plain = DrumControls::defaultsFor(Engine::TIA);
+	DrumControls bright = plain;
+	bright.values[DrumControls::TIA_BLENDEX1] = DrumControls::fromValue(127);
+	bright.values[DrumControls::TIA_FREQ1] = DrumControls::fromValue(100);
+	static std::array<int32_t, 4410> a;
+	static std::array<int32_t, 4410> b;
+	Voice voice;
+	renderVoice(voice, patch, a.data(), a.size(), 130.8, plain);
+	renderVoice(voice, patch, b.data(), b.size(), 130.8, bright);
+	auto roughness = [](const std::array<int32_t, 4410>& x) {
+		double d = 0;
+		for (size_t i = 1; i < x.size(); i++) {
+			d += std::abs(static_cast<double>(x[i]) - x[i - 1]);
+		}
+		return d;
+	};
+	CHECK(roughness(b) > roughness(a) * 1.5);
+}
+
+TEST(XiaTests, xiaSettingsAreHiddenFromLxrEngines) {
+	CHECK_FALSE(Patch::isUsedBy(Patch::XIA_VARIANT, Engine::DRUM));
+	CHECK_FALSE(Patch::isUsedBy(Patch::XIA_PUNCH, Engine::METAL));
+	CHECK(Patch::isUsedBy(Patch::XIA_PUNCH, Engine::IIA));
+	CHECK(Patch::isUsedBy(Patch::XIA_VARIANT, Engine::TIA));
+	CHECK_FALSE(Patch::isUsedBy(Patch::OSC_WAVE, Engine::TIA));
+	CHECK_FALSE(Patch::isUsedBy(Patch::PITCH_AMOUNT, Engine::IIA));
+	CHECK_FALSE(Patch::isUsedBy(Patch::FM_AMOUNT, Engine::TIA));
+	CHECK(Patch::isUsedBy(Patch::ENGINE, Engine::TIA));
+}
+
+TEST(XiaTests, olderSavesLoadWithXiaDefaults) {
+	// A kit saved before the XIA engines has only the LXR settings: the rest keep their defaults
+	Patch saved;
+	saved.setPreset(Preset::SNARE);
+	Patch loaded;
+	std::memcpy(loaded.bytes().data(), saved.bytes().data(), Patch::XIA_VARIANT);
+	loaded.clampAll();
+	CHECK(loaded.engine() == Engine::SNARE);
+	CHECK_EQUAL(0, loaded.get(Patch::XIA_VARIANT));
+	CHECK_EQUAL(0, loaded.get(Patch::XIA_PUNCH));
+}
+
+TEST(XiaTests, snappyDecayIsOnByDefaultAndSurvivesPresets) {
+	Patch patch;
+	CHECK_EQUAL(1, patch.get(Patch::SNAPPY_DECAY));
+	CHECK_EQUAL(1, Patch::maxValue(Patch::SNAPPY_DECAY));
+	patch.set(Patch::SNAPPY_DECAY, 0);
+	patch.setPreset(Preset::SNARE);
+	CHECK_EQUAL(0, patch.get(Patch::SNAPPY_DECAY));
+	patch.setXiaPreset(Engine::IIA, 2);
+	CHECK_EQUAL(0, patch.get(Patch::SNAPPY_DECAY));
+	CHECK(Patch::isUsedBy(Patch::SNAPPY_DECAY, Engine::METAL));
+	CHECK(Patch::isUsedBy(Patch::SNAPPY_DECAY, Engine::TIA));
+}
