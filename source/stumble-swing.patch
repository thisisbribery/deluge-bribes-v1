+++ b/src/deluge/dsp/drum_synth/xia_tables.c
@@ -0,0 +1,533 @@
+/*
+ * Lookup tables of the XIA TIA and IIA engines, read from the Model:Cycles firmware they were written for
+ * (model-cycles_OS1.13_XIA_2lfo.syx, payload at 0x43000000). Generated, do not edit.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include <stdint.h>
+
+// IIA variant H: 8 partial ratios (16.16) x 129 Weight steps. Firmware address 0x4300c614.
+const int32_t xiaRatioFm[1032] = {
+    65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,
+    65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,
+    65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,
+    65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,
+    65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,   65536,
